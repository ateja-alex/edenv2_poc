APP_NAME=TSI
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tsi.poc.ateja.corp
# Reseau des pods MKS (Traefik) : a verifier sur le cluster
TRUSTED_PROXIES=10.2.0.0/16
LOG_CHANNEL=stderr

# MariaDB commune (namespace eden-plateforme) : une base et un utilisateur par client
DB_CONNECTION=mysql
DB_HOST=mariadb.eden-plateforme.svc.cluster.local
DB_PORT=3306
DB_DATABASE=eden_tsi
DB_USERNAME=eden_tsi

# Redis du namespace du client
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_PREFIX=tsi_
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database
