<div class="row" style="text-align: center;border: 1px solid rgba(0,0,0,.125); margin:0;padding: 0; border-width: 0px 0px 1px 0px;">
	<div class="col-md-2" style="text-align: left;"><b style="font-size: 16px">Famille</b></div>
	<div class="col-md-8" style="text-align: left;"><b style="font-size: 16px">Désignation</b></div>
	<div class="col-md-1" style="text-align: right;"><b style="font-size: 16px">Tarif</b></div>
	<div class="col-md-1" style="text-align: right;"><b style="font-size: 16px">Prix achat</b></div>
</div>
<div class="row js_resultat_recherche css_resultat_recherche" v-for="article in articles_match.slice(0, 50)" @click="ajouter_article_regroupement(article,regroupement_en_cours)" style="border: 1px solid rgba(0,0,0,.125);margin: 0;padding: 3px;border-width: 0px 0px 1px 0px; line-height: 18px; cursor: pointer;">
	<div class="col-md-2" style="margin: 0;padding: 0;display: flex;align-items: center;">
		@{{article.fam | affiche_famille}}
	</div>
	<div class="col-md-8" style="margin: 0;padding: 0;">
		<div class="row">
			<div class="col-md-1">
				<img :src="'../storage/app/public/'+article.image" style="width: 75px" v-if="article.image != null">
			</div>
			<div class="col-md-11">
				<b style="font-size: 13px">@{{article.des}}</b> 
				<span class="badge badge-warning" v-show="article.typ == 1">{{ management('article')->champ('type_article')->affiche(1) }}</span>
				<span class="badge badge-warning" style="background-color:#f0ae41;" v-show="article.typ == 3">{{ management('article')->champ('type_article')->affiche(3) }}</span>
				<span class="badge badge-danger" v-show="article.typ == 2">Frais de port</span>
				<span class="badge badge-warning" v-show="article.pac == 1">Pack d'articles</span><br>
				@{{article.cod}}
			</div>
		</div>
	</div>
	<div class="col-md-1" style="margin: 0;padding: 0; text-align: center;display: flex;align-items: center; justify-content: flex-end;">
		<span v-if="article.tar != null">@{{article.tar}}€</span>
		
	</div>
	<div class="col-md-1" style="margin: 0;padding: 0;text-align: center;display: flex;align-items: center; justify-content: flex-end;">
		<span v-if="article.pri != null">@{{article.pri}}€</span>
	</div>
</div>